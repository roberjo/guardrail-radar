# Copy to .env for local runs (never commit the real file — see .gitignore).
# In GitHub Actions, these are repo secrets instead — see docs/technical-spec.md §16.

# connectors/reddit.py
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# connectors/github.py — search API rate limit (5000/hr authenticated vs 10/min)
GH_SEARCH_TOKEN=

# connectors/producthunt.py
PRODUCTHUNT_TOKEN=

# pipeline/notify.py — opens a "review packet ready" GitHub Issue in this
# repo. In Actions, GITHUB_TOKEN is provided automatically (no secret to
# set); for a local run, use a PAT with `issues: write` on this repo.
# GITHUB_REPOSITORY (owner/repo) is also auto-set in Actions; set it
# yourself for a local run. Never used for a subscriber-facing send — see
# docs/technical-spec.md §1, §15.2.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Optional: assigns the review-packet issue to this GitHub username so
# their own GitHub notification settings (email/mobile/etc.) fire. Not a
# secret — set as a repo Actions *variable*, not a secret, in CI.
MAINTAINER_GITHUB_USERNAME=
