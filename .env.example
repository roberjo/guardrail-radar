# Copy to .env for local runs (never commit the real file — see .gitignore).
# In GitHub Actions, these are repo secrets instead — see docs/technical-spec.md §16.

# connectors/reddit.py
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# connectors/github.py — search API rate limit (5000/hr authenticated vs 10/min)
GH_SEARCH_TOKEN=

# connectors/producthunt.py
PRODUCTHUNT_TOKEN=

# pipeline/notify.py — opens a "review packet ready" GitHub Issue, never a
# subscriber-facing send; see docs/technical-spec.md §1, §15.2. In GitHub
# Actions this is `secrets.GITHUB_TOKEN`, provided automatically — no repo
# secret to configure. For local testing only, set a personal token here
# (needs `issues` write on this repo) plus GITHUB_REPOSITORY as "owner/repo".
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Beehiiv API v2 — see pipeline/beehiiv.py and
# .claude/skills/beehiiv-api/SKILL.md. Free Launch tier includes general API
# access (publications/posts/subscribers) but not the dedicated Send API.
# BEEHIIV_API_KEY is the real secret (Beehiiv dashboard: Settings ->
# Workspace Settings -> API -> Create New API Key). BEEHIIV_PUB_API_KEY is
# NOT a secret, despite the name — it's the publication id
# (pub_ce3a249a-ebd9-4d23-8c43-1ca597987269), visible in the dashboard URL
# and every API response; pipeline/beehiiv.py falls back to that literal
# value if this is unset. Every post pipeline/beehiiv.py can create is
# forced to status="draft" — never auto-send, never auto-publish.
BEEHIIV_API_KEY=
BEEHIIV_PUB_API_KEY=
