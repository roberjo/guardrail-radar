# Copy to .env for local runs (never commit the real file — see .gitignore).
# In GitHub Actions, these are repo secrets instead — see docs/technical-spec.md §16.

# connectors/reddit.py
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# connectors/github.py — search API rate limit (5000/hr authenticated vs 10/min)
GH_SEARCH_TOKEN=

# connectors/producthunt.py
PRODUCTHUNT_TOKEN=

# pipeline/notify.py — opens a "review packet ready" GitHub Issue, never a
# subscriber-facing send; see docs/technical-spec.md §1, §15.2. In GitHub
# Actions this is `secrets.GITHUB_TOKEN`, provided automatically — no repo
# secret to configure. For local testing only, set a personal token here
# (needs `issues` write on this repo) plus GITHUB_REPOSITORY as "owner/repo".
GITHUB_TOKEN=
GITHUB_REPOSITORY=
